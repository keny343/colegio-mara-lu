{
  "type": "record",
  "name": "Transacao",
  "namespace": "colegio.mara_lu.lab",
  "doc": "Transação comercial sintética — Colégio Mara & Lu",
  "fields": [
    {"name": "id", "type": "long", "doc": "Identificador único da transação"},
    {"name": "cliente_id", "type": "long", "doc": "Identificador do cliente"},
    {"name": "produto_id", "type": "long", "doc": "Identificador do produto"},
    {"name": "data_transacao", "type": "string", "doc": "Data/hora ISO 8601 da transação"},
    {"name": "categoria", "type": "string", "doc": "Categoria do produto"},
    {"name": "quantidade", "type": "int", "doc": "Quantidade adquirida"},
    {"name": "preco_unitario", "type": "string", "doc": "Preço unitário em Decimal (string para precisão)"},
    {"name": "valor_total", "type": "string", "doc": "Valor total = quantidade * preco_unitario (Decimal string)"},
    {"name": "estado", "type": "string", "doc": "UF brasileira"},
    {"name": "descricao", "type": "string", "doc": "Descrição textual do item"},
    {
      "name": "localizacao",
      "type": {
        "type": "record",
        "name": "Localizacao",
        "fields": [
          {"name": "cidade", "type": "string"},
          {"name": "latitude", "type": "double"},
          {"name": "longitude", "type": "double"}
        ]
      },
      "doc": "Localização aninhada da venda"
    },
    {
      "name": "metadados",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Metadados",
          "fields": [
            {"name": "canal", "type": "string"},
            {"name": "promocao", "type": "boolean"},
            {"name": "vendedor_id", "type": ["null", "long"], "default": null}
          ]
        }
      ],
      "default": null,
      "doc": "Metadados opcionais da transação"
    }
  ]
}
