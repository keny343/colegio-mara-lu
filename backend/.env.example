# Base de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=colegio_mara_lu
# Use "true" se o MySQL exigir SSL (ex.: Aiven/Render)
DB_SSL=false

# Autenticação
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# CORS — origem do frontend
FRONTEND_URL=http://localhost:3000
# Opcionais (separadas por vírgula)
ADDITIONAL_ORIGINS=

# Porta da API
PORT=49152
# "production" para cookies Secure/SameSite=None (cross-origin com Vercel+Render)
NODE_ENV=development

# Supabase Storage (upload de ficheiros) — opcional se usar apenas Cloudinary
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cloudinary (imagens/PDF antigos) — opcional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
