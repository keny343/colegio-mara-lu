# URL base do servidor backend
# Em desenvolvimento: http://localhost:49152
# Em produção (Vercel): NÃO definir — o proxy em vercel.json redireciona /api/* para
# https://colegio-mara-lu-backend.onrender.com/api/* no mesmo domínio.
# Isto garante cookie first-party e sessão persistente em browsers mobile.
REACT_APP_API_URL=http://localhost:49152
